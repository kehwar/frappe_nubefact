# Absolute path of this checkout on the host.
HOST_WORKSPACE_PATH=${HOME}/workspace/frappe_nubefact

# Use a unique value per checkout so its persistent volumes cannot collide.
COMPOSE_PROJECT_NAME=nubefact-dev-main

SITE_NAME=development.localhost
DB_ROOT_PASSWORD=nubefact-dev-root-change-me
ADMIN_PASSWORD=nubefact-dev-admin-change-me

# Optional live NubeFact demo E2E configuration. Keep disabled unless the URL
# and token belong to a disposable demo account. Never commit real credentials.
NUBEFACT_E2E_ENABLED=0
NUBEFACT_E2E_API_URL=
NUBEFACT_E2E_API_TOKEN=
NUBEFACT_E2E_LOCAL=001
NUBEFACT_E2E_CODIGO_SUNAT=0000
NUBEFACT_E2E_FACTURA_SERIES=FFF1
NUBEFACT_E2E_BOLETA_SERIES=BBB1
NUBEFACT_E2E_GUIA_REMITENTE_SERIES=TTT1
NUBEFACT_E2E_GUIA_TRANSPORTISTA_SERIES=VVV1
